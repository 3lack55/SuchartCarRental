DB_NAME=car_company
DB_PASSWORD=changeme

# ใช้เฉพาะตอน build docker-compose.yml (ไฟล์ deploy จริง)
# IP ของเครื่องนี้บน tailnet (เช่น `tailscale ip -4`) — จำกัดให้ container bind กับ interface นี้เท่านั้น
# เข้าใช้งานจากอินเทอร์เน็ตทำผ่าน Cloudflare Quick Tunnel (service cloudflared ใน docker-compose.yml) แทน
TAILSCALE_IP=100.x.x.x

# ปล่อยว่างไว้ (อย่าตั้งค่า) — frontend จะเรียก API แบบ relative path (/api/...) ผ่าน nginx proxy แทน
# ทำให้เข้าเว็บได้ทั้งผ่าน Tailscale IP โดยตรงและผ่าน Cloudflare Quick Tunnel โดยไม่ต้อง build frontend ใหม่
# VITE_API_HOST=
# VITE_API_PORT=
# VITE_API_PROTOCOL=
